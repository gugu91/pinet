{
  "name": "@pinet/tmux",
  "version": "0.2.25",
  "type": "module",
  "description": "Optional Pi pane state, attention and compaction publisher for tmux",
  "author": "Will Porcellini <5994936+gugu91@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gugu91/pinet.git",
    "directory": "tmux"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "keywords": [
    "pi-package",
    "tmux",
    "terminal",
    "pinet"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node ../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "lint": "cd .. && oxlint tmux tmux-plugin",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../vitest.config.ts *.test.ts && node --test index.test.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
