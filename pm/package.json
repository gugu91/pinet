{
  "name": "@pinet/pm",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "description": "Opt-in project-management behaviour for Pi",
  "keywords": [
    "pi-package"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node ../scripts/build-package.mjs",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../vitest.config.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  }
}
