{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@pinet/tmux#lint": {
      "inputs": ["**/*.ts", "../tmux-plugin/**/*.ts", "../.oxlintrc.json"],
      "outputs": []
    },
    "@pinet/tmux#typecheck": {
      "inputs": [
        "**/*.ts",
        "../tmux-plugin/**/*.ts",
        "tsconfig.json",
        "../tsconfig.json",
        "../types/**/*.d.ts"
      ],
      "outputs": []
    },
    "@pinet/tmux#test": {
      "inputs": [
        "**/*.ts",
        "**/*.mjs",
        "../tmux-plugin/**",
        "../pinet.tmux",
        "../vitest.config.ts",
        "../pnpm-lock.yaml"
      ],
      "outputs": [],
      "passThroughEnv": ["TMPDIR"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/*.ts",
        "!**/*.test.ts",
        "tsconfig.json",
        "../tsconfig.json",
        "../types/**/*.d.ts"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["**/*.ts", "../.oxlintrc.json"],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["**/*.ts", "tsconfig.json", "../tsconfig.json", "../types/**/*.d.ts"],
      "outputs": []
    },
    "test": {
      "inputs": [
        "**/*.ts",
        "**/*.test.ts",
        "vitest.config.ts",
        "../vitest.config.ts",
        "../pnpm-lock.yaml"
      ],
      "env": ["SKIP_SLACK_BRIDGE_PACKAGE_BUILD_TEST"],
      "outputs": [],
      "passThroughEnv": ["TMPDIR"]
    }
  }
}
