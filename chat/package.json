{
  "name": "@pinet/chat",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "description": "Authenticated agent chat and tracked runtime coordination",
  "keywords": [
    "pi-package"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "pinet-chat": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node ../scripts/build-package.mjs",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../vitest.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.10.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  }
}
